<div class="mx-auto flex max-w-6xl flex-col gap-10 px-4 py-12">
  <header class="space-y-3 text-slate-100">
    <p class="text-xs font-semibold uppercase tracking-[0.45em] text-brand-gold">CineVerse Movies</p>
    <h1 class="font-heading text-3xl text-white md:text-4xl">上映作品</h1>
    <p class="text-sm leading-relaxed text-slate-300">
      CineVerseで上映中・上映予定の作品一覧です。気になるタイトルを絞り込んで、詳細から上映スケジュールをチェックしましょう。
    </p>
  </header>

  <section class="space-y-8">
    <%= form_with url: movies_path, method: :get, local: true, class: 'grid gap-4 rounded-2xl border border-white/10 bg-slate-900/60 p-6 shadow-lg md:grid-cols-12 md:items-end' do %>
      <div class="space-y-2 md:col-span-7">
        <%= label_tag :keyword, 'キーワード検索', class: 'form-label' %>
        <%= text_field_tag :keyword, params[:keyword], class: 'form-input', placeholder: '作品名・キャスト・説明で検索' %>
      </div>

      <div class="space-y-2 md:col-span-3">
        <%= label_tag :is_showing, '上映ステータス', class: 'form-label' %>
        <%= select_tag :is_showing,
              options_for_select([
                ['すべて', ''],
                ['上映中', '1'],
                ['上映予定', '0']
              ], params[:is_showing].presence || ''),
              class: 'form-select' %>
      </div>

      <div class="flex flex-col gap-3 md:col-span-2">
        <%= submit_tag '検索する', class: 'btn-primary w-full justify-center' %>
        <% if params[:keyword].present? || params[:is_showing].present? %>
          <%= link_to '条件をクリア', movies_path, class: 'btn-secondary justify-center' %>
        <% end %>
      </div>
    <% end %>

    <div class="flex flex-col gap-3 text-slate-200 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.35em] text-slate-500">Movie List</p>
        <h2 class="mt-1 text-2xl font-semibold text-white">作品一覧</h2>
      </div>
      <span class="text-xs font-semibold tracking-[0.3em] text-slate-500">全 <%= @movies.size %> 作品</span>
    </div>

    <% if @movies.present? %>
      <div class="movie-table">
        <% @movies.each do |movie| %>
          <article class="movie-row">
            <div class="movie-row__poster">
              <% if movie.image_url.present? %>
                <%= image_tag movie.image_url, alt: "#{movie.name}のポスター" %>
              <% else %>
                <div class="movie-row__poster--empty">No Poster</div>
              <% end %>
            </div>

            <div class="movie-row__body">
              <div class="movie-row__header">
                <div class="movie-row__labels">
                  <span class="badge <%= movie.is_showing ? 'badge--showing' : 'badge--upcoming' %>">
                    <%= movie.is_showing ? '上映中' : '上映予定' %>
                  </span>
                </div>
                <h3 class="movie-row__title"><%= movie.name %></h3>
              </div>

              <p class="movie-row__description">
                <%= truncate(movie.description.to_s, length: 150) %>
              </p>

              <div class="movie-row__footer">
                <%= link_to '詳細を見る', movie_path(movie), class: 'btn-primary w-full justify-center md:w-auto md:justify-start' %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <strong class="text-accent">該当する作品が見つかりませんでした</strong>
        <p class="text-soft text-sm">検索条件を変更するか、フィルターをリセットして再度お試しください。</p>
      </div>
    <% end %>
  </section>
</div>
