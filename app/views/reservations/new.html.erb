<div class="page-shell">
  <div>
    <%= link_to '← 座席選択に戻る', reservation_movie_path(@movie, schedule_id: @schedule.id, date: @date), class: 'btn-secondary text-xs sm:text-sm' %>
  </div>

  <section class="reservation-layout">
    <aside class="reservation-summary">
      <h2>予約内容の確認</h2>
      <dl>
        <div>
          <dt>作品</dt>
          <dd><%= @movie.name %></dd>
        </div>
        <div>
          <dt>上映日</dt>
          <dd><%= Date.parse(@date.to_s).strftime('%Y年%-m月%-d日') rescue @date %></dd>
        </div>
        <div>
          <dt>上映時間</dt>
          <dd><%= @schedule.start_time.strftime('%H:%M') %>〜<%= @schedule.end_time.strftime('%H:%M') %></dd>
        </div>
        <div>
          <dt>スクリーン</dt>
          <dd>スクリーン <%= @schedule.screen_id %></dd>
        </div>
        <div>
          <dt>座席</dt>
          <dd><%= "#{@sheet.row.upcase}-#{@sheet.column}" %></dd>
        </div>
      </dl>
      <p class="text-soft text-sm">
        予約者情報はログイン中のアカウントで自動入力されます。内容を確認して問題がなければ「予約を確定する」ボタンを押してください。
      </p>
    </aside>

    <div class="reservation-form">
      <h2 class="reservation-form__title">予約者情報</h2>
      <p class="text-soft text-sm">入力内容は予約確定後に確認メールとして送信されます。</p>

      <%= form_with model: @reservation, url: reservations_path, local: true, class: 'form-stack' do |f| %>
        <%= f.hidden_field :schedule_id, value: @schedule.id %>
        <%= f.hidden_field :sheet_id, value: @sheet.id %>
        <%= f.hidden_field :date, value: @date %>
        <%= f.hidden_field :screen_id, value: @schedule.screen_id %>

        <div class="form-field">
          <%= f.label :name, '予約者氏名', class: 'form-label' %>
          <%= f.text_field :name, value: current_user.name, readonly: true, class: 'form-input' %>
        </div>

        <div class="form-field">
          <%= f.label :email, '予約者メールアドレス', class: 'form-label' %>
          <%= f.email_field :email, value: current_user.email, readonly: true, class: 'form-input' %>
        </div>

        <div class="flex flex-wrap gap-3 pt-2">
          <%= f.submit '予約を確定する', class: 'btn-primary w-full sm:w-auto justify-center' %>
        </div>
      <% end %>
    </div>
  </section>
</div>
