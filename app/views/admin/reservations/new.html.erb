<div class="page-shell space-y-10">
  <section class="page-hero">
    <div class="page-hero__content">
      <span class="page-hero__kicker">
        <span class="text-brand-gold">Admin</span>
        RESERVATION CREATE
      </span>
      <h1 class="page-hero__title">予約を追加</h1>
      <p class="page-hero__description">
        上映スケジュールを選ぶと、対応するスクリーンと座席候補が自動で表示されます。重複している座席は登録できません。
      </p>
      <div class="mt-4 flex flex-wrap gap-3 text-sm">
        <%= link_to '⟵ 予約一覧へ戻る', admin_reservations_path, class: 'btn-secondary text-xs sm:text-sm' %>
      </div>
    </div>
  </section>

  <section class="card-surface space-y-8">
    <div class="rounded-xl border border-white/5 bg-white/[0.03] p-6">
      <h2 class="text-base font-semibold text-white">予約情報を入力</h2>
      <%= form_with model: [:admin, @reservation], url: admin_reservations_path, method: :post, local: true, class: 'mt-4 space-y-6' do |f| %>
        <% if @reservation.errors.any? %>
          <div class="rounded-lg border border-brand-red/40 bg-brand-red/10 px-4 py-3 text-sm text-brand-red">
            <p class="font-semibold">入力内容を確認してください。</p>
            <ul class="mt-2 list-disc space-y-1 pl-5">
              <% @reservation.errors.each do |error| %>
                <li><%= error.message.delete_prefix('^') %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid gap-6 md:grid-cols-2">
          <div class="space-y-2">
            <%= f.label :schedule_id, '上映スケジュール', class: 'text-sm font-semibold text-white' %>
            <% schedule_options = @schedules.map do |schedule|
                 movie_title = schedule.movie&.name || '未設定'
                 screen_name = schedule.screen&.name || "スクリーン#{schedule.screen_id}"
                 start_label = schedule.start_time&.strftime('%Y-%m-%d %H:%M') || '-'
                 end_label = schedule.end_time&.strftime('%H:%M') || '-'
                 label = "##{schedule.id} | #{movie_title} | #{screen_name} | #{start_label}〜#{end_label}"
                 [
                   label,
                   schedule.id,
                   {
                     'data-screen-id': schedule.screen_id,
                     'data-screen-name': screen_name,
                     'data-movie-title': movie_title,
                     'data-start-time': start_label,
                     'data-end-time': end_label
                   }
                 ]
               end %>
            <%= f.select :schedule_id,
                         options_for_select(schedule_options, @reservation.schedule_id),
                         { include_blank: '上映スケジュールを選択してください' },
                         class: 'form-select',
                         required: true,
                         data: { reservation_schedule: true } %>
            <p class="text-xs text-slate-500">上映スケジュールを選ぶとスクリーンと座席候補が自動で切り替わります。</p>
          </div>
          <div class="space-y-2">
            <%= f.label :sheet_id, '座席', class: 'text-sm font-semibold text-white' %>
            <% seat_options = @available_sheets.map do |sheet|
                 [
                   "#{sheet.row.to_s.upcase}-#{sheet.column}",
                   sheet.id,
                   { 'data-screen-id': sheet.screen_id }
                 ]
               end %>
            <%= f.select :sheet_id,
                         options_for_select(seat_options, @reservation.sheet_id),
                         { include_blank: '座席を選択してください' },
                         class: 'form-select',
                         required: true,
                         data: { reservation_seat: true },
                         disabled: @selected_schedule.blank? %>
            <p class="text-xs text-slate-500">スクリーンに紐づく座席のみ選択できます。</p>
          </div>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          <div class="space-y-2">
            <label class="text-sm font-semibold text-white">選択中のスクリーン</label>
            <div class="rounded-lg border border-white/10 bg-white/[0.02] px-4 py-3 text-sm text-slate-200" data-screen-display>
              <% if @selected_schedule %>
                <span class="text-white font-semibold"><%= (@selected_schedule.screen&.name || "スクリーン#{@selected_schedule.screen_id}") %></span>
                <span class="ml-2 text-xs text-slate-400">ID: <%= @selected_schedule.screen_id %></span>
              <% else %>
                <span class="text-slate-500">上映スケジュールを選択してください</span>
              <% end %>
            </div>
          </div>
          <div class="space-y-2">
            <label class="text-sm font-semibold text-white">上映情報</label>
            <div class="rounded-lg border border-white/10 bg-white/[0.02] px-4 py-3 text-sm text-slate-200" data-timeslot-display>
              <% if @selected_schedule %>
                <p class="font-semibold text-white"><%= @selected_schedule.movie&.name || '未設定' %></p>
                <p class="text-xs text-slate-400 mt-1">
                  <%= @selected_schedule.start_time&.strftime('%Y-%m-%d %H:%M') || '-' %>
                  〜
                  <%= @selected_schedule.end_time&.strftime('%H:%M') || '-' %>
                </p>
              <% else %>
                <span class="text-slate-500">上映スケジュールを選択すると表示されます</span>
              <% end %>
            </div>
          </div>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          <div class="space-y-2">
            <%= f.label :name, '予約者氏名', class: 'text-sm font-semibold text-white' %>
            <%= f.text_field :name, class: 'form-input', required: true %>
          </div>
          <div class="space-y-2">
            <%= f.label :email, '予約者メールアドレス', class: 'text-sm font-semibold text-white' %>
            <%= f.email_field :email, class: 'form-input', required: true %>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <%= f.submit '予約を作成する', class: 'btn-primary' %>
        </div>
      <% end %>
    </div>
  </section>
</div>

<%= javascript_tag do %>
  document.addEventListener('turbo:load', setupReservationFormEnhancements);
  document.addEventListener('turbo:frame-load', setupReservationFormEnhancements);
  document.addEventListener('DOMContentLoaded', setupReservationFormEnhancements);

  function setupReservationFormEnhancements() {
    const scheduleSelect = document.querySelector('[data-reservation-schedule]');
    const seatSelect = document.querySelector('[data-reservation-seat]');
    const screenDisplay = document.querySelector('[data-screen-display]');
    const timeslotDisplay = document.querySelector('[data-timeslot-display]');

    if (!scheduleSelect || !seatSelect || !screenDisplay || !timeslotDisplay) return;

    const renderScreenInfo = (name, id) => {
      screenDisplay.innerHTML = '';
      const titleSpan = document.createElement('span');
      titleSpan.className = 'text-white font-semibold';
      titleSpan.textContent = name;
      screenDisplay.appendChild(titleSpan);

      const idSpan = document.createElement('span');
      idSpan.className = 'ml-2 text-xs text-slate-400';
      idSpan.textContent = `ID: ${id}`;
      screenDisplay.appendChild(idSpan);
    };

    const renderTimeslotInfo = (movieTitle, startTime, endTime) => {
      timeslotDisplay.innerHTML = '';

      const title = document.createElement('p');
      title.className = 'font-semibold text-white';
      title.textContent = movieTitle;

      const period = document.createElement('p');
      period.className = 'text-xs text-slate-400 mt-1';
      period.textContent = `${startTime} 〜 ${endTime}`;

      timeslotDisplay.appendChild(title);
      timeslotDisplay.appendChild(period);
    };

    const renderPlaceholders = () => {
      screenDisplay.innerHTML = '<span class="text-slate-500">上映スケジュールを選択してください</span>';
      timeslotDisplay.innerHTML = '<span class="text-slate-500">上映スケジュールを選択すると表示されます</span>';
    };

    const updateFormState = () => {
      const selectedOption = scheduleSelect.options[scheduleSelect.selectedIndex];
      const screenId = selectedOption ? selectedOption.dataset.screenId : null;
      const screenName = selectedOption ? selectedOption.dataset.screenName : null;
      const movieTitle = selectedOption ? selectedOption.dataset.movieTitle : null;
      const startTime = selectedOption ? selectedOption.dataset.startTime : null;
      const endTime = selectedOption ? selectedOption.dataset.endTime : null;

      let shouldResetSeat = false;

      Array.from(seatSelect.options).forEach((option) => {
        if (!option.value) return;
        const matches = screenId && option.dataset.screenId === screenId;
        option.hidden = !matches;
        option.disabled = !matches;
        if (!matches && option.selected) {
          option.selected = false;
          shouldResetSeat = true;
        }
      });

      if (screenId) {
        seatSelect.disabled = false;
        seatSelect.removeAttribute('disabled');
        if (shouldResetSeat || !seatSelect.value) {
          seatSelect.selectedIndex = 0;
        }
        renderScreenInfo(screenName, screenId);
        renderTimeslotInfo(movieTitle, startTime, endTime);
      } else {
        seatSelect.disabled = true;
        seatSelect.setAttribute('disabled', 'disabled');
        seatSelect.selectedIndex = 0;
        renderPlaceholders();
      }
    };

    scheduleSelect.addEventListener('change', updateFormState);
    updateFormState();
  }
<% end %>
