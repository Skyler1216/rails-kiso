<div class="page-shell space-y-10">
  <div class="flex flex-wrap gap-3 text-sm">
    <%= link_to '⟵ 映画一覧に戻る', admin_movies_path, class: 'btn-secondary text-xs sm:text-sm' %>
  </div>

  <section class="card-surface space-y-6">
    <%= render 'form', movie: @movie, heading: '作品情報の入力', subheading: '必須項目を入力してください', submit_label: '登録する', submit_note: '送信先: POST /admin/movies' %>
  </section>
</div>
