<div class="page-shell space-y-10">
  <section class="page-hero">
    <div class="page-hero__content">
      <span class="page-hero__kicker">
        <span class="text-brand-gold">Admin</span>
        MOVIE DETAIL
      </span>
      <h1 class="page-hero__title"><%= @movie.name %></h1>
      <p class="page-hero__description">
        作品ID <%= @movie.id %> の管理ページです。上映スケジュールの確認と追加、作品情報の把握ができます。
      </p>
      <div class="mt-4 flex flex-wrap gap-3 text-sm">
        <%= link_to '⟵ 映画一覧に戻る', admin_movies_path, class: 'btn-secondary text-xs sm:text-sm' %>
        <%= link_to '作品を編集', edit_admin_movie_path(@movie), class: 'btn-secondary text-xs sm:text-sm' %>
      </div>
    </div>
  </section>

  <section class="card-surface space-y-8">
    <div class="rounded-xl border border-white/5 bg-white/[0.03] p-6">
      <h2 class="text-base font-semibold text-white">作品情報</h2>
      <dl class="mt-4 grid gap-4 text-sm text-slate-300 md:grid-cols-2">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-500">作品ID</dt>
          <dd class="font-medium text-white"><%= @movie.id %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-500">公開年</dt>
          <dd class="font-medium text-white"><%= @movie.year %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-500">上映ステータス</dt>
          <dd class="font-medium text-white"><%= @movie.is_showing ? '上映中' : '上映予定' %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-500">作成日時</dt>
          <dd class="font-medium text-white"><%= @movie.created_at.strftime('%Y-%m-%d %H:%M') %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-500">更新日時</dt>
          <dd class="font-medium text-white"><%= @movie.updated_at.strftime('%Y-%m-%d %H:%M') %></dd>
        </div>
      </dl>
      <div class="mt-4 text-sm leading-relaxed text-slate-300">
        <h3 class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-500">概要</h3>
        <p class="mt-2 whitespace-pre-line text-white/90"><%= @movie.description.presence || '概要は登録されていません。' %></p>
      </div>
    </div>

    <div class="rounded-xl border border-white/5 bg-white/[0.03] p-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-base font-semibold text-white">上映スケジュール</h2>
        <div class="flex flex-wrap items-center gap-2 text-xs sm:text-sm">
          <%= link_to 'スケジュール一覧', admin_schedules_path, class: 'btn-secondary text-xs sm:text-sm' %>
          <%= link_to 'スケジュールを追加', new_admin_movie_schedule_path(@movie), class: 'btn-primary text-xs sm:text-sm' %>
        </div>
      </div>

      <% if @schedules.present? %>
        <ul class="mt-5 space-y-3">
          <% @schedules.each do |schedule| %>
            <%= render partial: 'admin/schedules/schedule_summary', locals: { schedule: schedule } %>
          <% end %>
        </ul>
      <% else %>
        <div class="mt-5 rounded-lg border border-dashed border-white/10 bg-white/[0.02] px-6 py-8 text-sm text-slate-400">
          この作品にはまだスケジュールが登録されていません。<%= link_to 'スケジュールを追加する', new_admin_movie_schedule_path(@movie), class: 'text-brand-gold underline decoration-dotted underline-offset-4 hover:text-brand-red' %> から追加してください。
        </div>
      <% end %>
    </div>
  </section>
</div>
