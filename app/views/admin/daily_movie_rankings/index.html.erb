<%# ============================================================================
    # 管理者向け 人気作品ランキング履歴ページ
    # station 5,6の変更箇所
    # ============================================================================
    # 日次で保存される人気作品ランキングのスナップショットを閲覧し、
    # 過去との順位・予約数の差分を確認できる管理画面です。
    # 
    # 【主な機能】
    # 1. 集計日選択によるランキング履歴の閲覧
    # 2. 前日比での順位変動・予約数変動の表示
    # 3. 過去にランキングに含まれていた作品の現在状況確認
    # 4. ナビゲーション機能（前の日付・次の日付）
    # 
    # 【表示データ】
    # - @available_dates: 利用可能な集計日一覧
    # - @selected_date: 現在選択されている集計日
    # - @rankings: 選択日のランキングデータ（正規化済み）
    # - @rankings_diff: 順位変動（前日比）
    # - @reservation_diff: 予約数変動（前日比）
    # - @next_date, @previous_date: ナビゲーション用の前後の日付
    # ============================================================================
%>

<div class="page-shell">
  <%# ============================================================================
      # ページヘッダーセクション
      # ============================================================================
      # ページのタイトルと説明を表示するセクションです。
      # 管理者向けのアナリティクスページであることを明示しています。
      # ============================================================================
  %>
  <section class="page-hero">
    <div class="page-hero__content">
      <span class="page-hero__kicker">
        <span class="text-brand-gold">Admin</span>
        ANALYTICS
      </span>
      <h1 class="page-hero__title">人気作品ランキング履歴</h1>
      <p class="page-hero__description">
        集計日ごとのランキング推移を確認できます。任意の日付を選択して詳細をチェックしましょう。
      </p>
    </div>
  </section>

  <%# ============================================================================
      # メインコンテンツセクション
      # ============================================================================
      # ランキング履歴の表示と操作を行うメインセクションです。
      # カード形式のUIで情報を整理して表示します。
      # ============================================================================
  %>
  <section class="card-surface space-y-6">
    <%# ============================================================================
        # セクションヘッダー
        # ============================================================================
        # セクションのタイトルと日付選択フォームを配置するヘッダー部分です。
        # レスポンシブデザインに対応したレイアウトになっています。
        # ============================================================================
    %>
    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
      <%# セクションタイトル部分 %>
      <div class="space-y-2">
        <p class="text-xs font-semibold uppercase tracking-[0.35em] text-slate-500">Ranking History</p>
        <h2 class="text-2xl font-semibold text-white">ランキングの履歴管理</h2>
      </div>

      <%# ============================================================================
          # 日付選択・ナビゲーション部分
          # ============================================================================
          # 利用可能な集計日がある場合のみ表示される部分です。
          # 日付選択フォームと前後の日付へのナビゲーションボタンを提供します。
          # ============================================================================
      %>
      <% if @available_dates.present? %>
        <div class="flex flex-col gap-3 md:items-end">
          <%# 日付選択フォーム %>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <%= form_with url: admin_daily_movie_rankings_path, method: :get, local: true, class: 'flex items-center gap-3' do %>
              <%= label_tag :date, '表示日を選択', class: 'text-sm font-semibold text-slate-300 whitespace-nowrap' %>
              <%# 利用可能な日付から選択肢を生成（YYYY/MM/DD形式で表示、値はDateオブジェクト） %>
              <%= select_tag :date,
                    options_for_select(@available_dates.map { |d| [d.strftime('%Y/%m/%d'), d] }, @selected_date),
                    class: 'form-select w-auto text-xs sm:text-sm' %>
              <%= submit_tag '表示', class: 'btn-primary text-xs sm:text-sm' %>
            <% end %>
          </div>

          <%# ============================================================================
              # 前後の日付ナビゲーション
              # ============================================================================
              # 前の日付または次の日付が存在する場合に表示されるナビゲーションボタンです。
              # コントローラーで計算された@next_dateと@previous_dateを使用します。
              # ============================================================================
          %>
          <% if @previous_date.present? || @next_date.present? %>
            <div class="flex items-center gap-2">
              <%# 次の日付（より新しい日付）へのリンク %>
              <% if @next_date.present? %>
                <%= link_to '次の日付', admin_daily_movie_rankings_path(date: @next_date), class: 'btn-secondary text-xs sm:text-sm' %>
              <% end %>
              <%# 前の日付（より古い日付）へのリンク %>
              <% if @previous_date.present? %>
                <%= link_to '前の日付', admin_daily_movie_rankings_path(date: @previous_date), class: 'btn-secondary text-xs sm:text-sm' %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# ============================================================================
        # データ表示部分
        # ============================================================================
        # ランキングデータの有無に応じて表示内容を切り替えます。
        # データがない場合は説明メッセージを表示し、
        # データがある場合はランキングテーブルを表示します。
        # ============================================================================
    %>
    <% if @available_dates.blank? %>
      <%# ============================================================================
          # データなし状態の表示
          # ============================================================================
          # ランキングデータがまだ存在しない場合に表示されるメッセージです。
          # バッチ実行の必要性をユーザーに伝えます。
          # ============================================================================
      %>
      <div class="rounded-lg border border-dashed border-white/10 bg-white/5 px-6 py-10 text-center text-sm text-slate-400">
        まだランキングデータがありません。バッチを実行すると履歴がここに表示されます。
      </div>
    <% else %>
      <%# ============================================================================
          # ランキングデータ表示
          # ============================================================================
          # ランキングデータが存在する場合に表示されるメインコンテンツです。
          # 選択された日付の情報とランキングテーブルを含みます。
          # ============================================================================
      %>
      <div class="space-y-5 rounded-xl border border-white/10 bg-white/[0.02] p-6">
        <%# ============================================================================
            # 集計日情報ヘッダー
            # ============================================================================
            # 選択された集計日と登録日数を表示するヘッダー部分です。
            # ユーザーが現在どの日付のデータを見ているかを明確にします。
            # ============================================================================
        %>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h3 class="text-xl font-semibold text-white">
              集計日: <%= @selected_date.strftime('%Y/%m/%d') %>
            </h3>
          </div>

          <%# 登録日数の表示（バッジ形式） %>
          <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold uppercase tracking-[0.28em] text-slate-300">
            登録日数 <%= @available_dates.size %> 日
          </span>
        </div>

        <%# ============================================================================
            # ランキングテーブル
            # ============================================================================
            # ランキングデータを表形式で表示するテーブルです。
            # 順位、作品名、予約件数、順位変動、予約件数変動の5列で構成されています。
            # レスポンシブデザインに対応し、横スクロール可能です。
            # ============================================================================
        %>
        <div class="overflow-x-auto rounded-lg border border-white/5 bg-slate-950/60">
          <table class="min-w-full divide-y divide-white/5 text-left text-sm text-slate-200">
            <%# テーブルヘッダー %>
            <thead class="bg-slate-900/80 text-xs uppercase tracking-[0.28em] text-slate-400">
              <tr>
                <th scope="col" class="whitespace-nowrap px-4 py-3">順位</th>
                <th scope="col" class="whitespace-nowrap px-4 py-3">作品名</th>
                <th scope="col" class="whitespace-nowrap px-4 py-3 text-right">予約件数</th>
                <th scope="col" class="whitespace-nowrap px-4 py-3 text-right">順位変動（前日比）</th>
                <th scope="col" class="whitespace-nowrap px-4 py-3 text-right">予約件数（前日比）</th>
              </tr>
            </thead>
            <%# テーブルボディ %>
            <tbody class="divide-y divide-white/5">
              <%# ============================================================================
                  # ランキング行の表示
                  # ============================================================================
                  # 各ランキングエントリを順番に表示します。
                  # @rankingsはコントローラーで取得したデータです。
                  # 各作品の順位変動と予約数変動を@rankings_diffと@reservation_diffから取得します。
                  # ============================================================================
              %>
              <% @rankings.each do |ranking| %>
                <%# 現在の作品の順位変動と予約数変動を取得 %>
                <% rank_diff = @rankings_diff[ranking.movie_id] %>
                <% reservation_diff = @reservation_diff[ranking.movie_id] %>
                <tr class="transition hover:bg-slate-900/60">
                  <%# ============================================================================
                      # 順位列
                      # ============================================================================
                      # 予約数が0の場合は「ー」を表示し、
                      # 予約数がある場合は「No.順位」の形式で表示します。
                      # ============================================================================
                  %>
                  <td class="whitespace-nowrap px-4 py-4 font-semibold text-white">
                    <% if ranking.reservation_count.zero? %>
                      <span>ー</span>
                    <% else %>
                      <span>No.<%= ranking.rank_position %></span>
                    <% end %>
                  </td>
                  
                  <%# ============================================================================
                      # 作品名列
                      # ============================================================================
                      # 作品名とMovie IDを表示します。
                      # 作品名はメインの情報として大きく表示し、
                      # Movie IDは補助情報として小さく表示します。
                      # ============================================================================
                  %>
                  <td class="px-4 py-4">
                    <div class="flex flex-col">
                      <span class="text-sm font-medium text-white"><%= ranking.movie.name %></span>
                      <span class="text-xs text-slate-400">Movie ID: <%= ranking.movie_id %></span>
                    </div>
                  </td>
                  
                  <%# ============================================================================
                      # 予約件数列
                      # ============================================================================
                      # 予約件数をカンマ区切りで表示します。
                      # 数値の可読性を向上させるためnumber_with_delimiterを使用しています。
                      # ============================================================================
                  %>
                  <td class="whitespace-nowrap px-4 py-4 text-right font-semibold text-slate-100">
                    <%= number_with_delimiter(ranking.reservation_count) %> 件
                  </td>
                  
                  <%# ============================================================================
                      # 順位変動列
                      # ============================================================================
                      # 前日比での順位変動を表示します。
                      # 表示パターン：
                      # - 予約数0: 「-」
                      # - 前日データなし: 「NEW」（緑色のバッジ）
                      # - 順位上昇: 「↑ 変動数」（緑色）
                      # - 順位下降: 「↓ 変動数」（赤色）
                      # - 変動なし: 「-」
                      # ============================================================================
                  %>
                  <td class="whitespace-nowrap px-4 py-4 text-right">
                    <% if ranking.reservation_count.zero? %>
                      <%# 予約数0の場合は変動を表示しない %>
                      <span class="text-slate-400">-</span>
                    <% elsif rank_diff.nil? %>
                      <%# 前日データがない場合は新規として表示 %>
                      <span class="rounded-full bg-emerald-500/10 px-2 py-1 text-xs text-emerald-300">NEW</span>
                    <% elsif rank_diff.positive? %>
                      <%# 順位上昇（正の値）の場合は緑色で上矢印を表示 %>
                      <span class="text-emerald-300">↑ <%= rank_diff %></span>
                    <% elsif rank_diff.negative? %>
                      <%# 順位下降（負の値）の場合は赤色で下矢印を表示 %>
                      <span class="text-rose-300">↓ <%= rank_diff.abs %></span>
                    <% else %>
                      <%# 変動なし（0）の場合は「-」を表示 %>
                      <span class="text-slate-400">-</span>
                    <% end %>
                  </td>
                  
                  <%# ============================================================================
                      # 予約件数変動列
                      # ============================================================================
                      # 前日比での予約件数変動を表示します。
                      # 表示パターン：
                      # - 予約数0: 「-」
                      # - 前日データなし: 「-」
                      # - 予約数増加: 「+変動数」（緑色）
                      # - 予約数減少: 「変動数」（赤色）
                      # - 変動なし: 「±0」
                      # ============================================================================
                  %>
                  <td class="whitespace-nowrap px-4 py-4 text-right">
                    <% if ranking.reservation_count.zero? %>
                      <%# 予約数0の場合は変動を表示しない %>
                      <span class="text-slate-400">-</span>
                    <% elsif reservation_diff.nil? %>
                      <%# 前日データがない場合は変動を表示しない %>
                      <span class="text-slate-400">-</span>
                    <% elsif reservation_diff.positive? %>
                      <%# 予約数増加（正の値）の場合は緑色で「+」を表示 %>
                      <span class="text-emerald-300">+<%= number_with_delimiter(reservation_diff) %></span>
                    <% elsif reservation_diff.negative? %>
                      <%# 予約数減少（負の値）の場合は赤色で表示（マイナス記号は自動付与） %>
                      <span class="text-rose-300"><%= number_with_delimiter(reservation_diff) %></span>
                    <% else %>
                      <%# 変動なし（0）の場合は「±0」を表示 %>
                      <span class="text-slate-400">±0</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </section>
</div>
