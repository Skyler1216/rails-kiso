<%# 上映スケジュールの一覧ページ
    構成:
      - ヒーロー（ページタイトル・説明）
      - 集計カード（総数/作品数/上映中/今週）
      - フィルタ（劇場プルダウン + 件数表示 + 追加ボタン）
      - 時刻順テーブル（終了済みはグレー表示）
      - 作品別のまとまり一覧（By Movie）
%>
<div class="page-shell space-y-10">
  <section class="page-hero">
    <div class="page-hero__content">
      <span class="page-hero__kicker">
        <span class="text-brand-gold">Admin</span>
        SCHEDULE MANAGEMENT
      </span>
      <h1 class="page-hero__title">上映スケジュール</h1>
      <p class="page-hero__description">
        スケジュール全体の状況を集計し、時刻順の一覧で確認できます。映画別のまとまりも下部に掲載しています。
      </p>
    </div>
  </section>

  <section class="card-surface space-y-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-xs uppercase tracking-[0.35em] text-slate-500">Timeline</p>
        <h2 class="text-xl font-semibold text-white">時刻順スケジュール一覧</h2>
      </div>
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:gap-6">
        <%# 劇場フィルタフォーム（GET） %>
        <%= form_with url: admin_schedules_path, method: :get, local: true, class: 'flex flex-wrap items-center gap-3 text-xs sm:text-sm' do |f| %>
          <div class="space-y-1">
            <%= f.label :theater_id, '劇場フィルタ', class: 'text-xs font-semibold uppercase tracking-[0.3em] text-slate-400' %>
            <%= f.select :theater_id,
                        options_for_select(@theaters.map { |theater| ["#{theater.name} (ID: #{theater.id})", theater.id] }, @selected_theater_id),
                        { include_blank: '全ての劇場' },
                        class: 'form-select text-sm' %>
          </div>
          <div class="flex items-center gap-2">
            <%= f.submit '適用', class: 'btn-secondary text-xs sm:text-sm' %>
            <% if @selected_theater_id.present? %>
              <%= link_to 'クリア', admin_schedules_path, class: 'text-xs text-slate-400 underline decoration-dotted hover:text-white' %>
            <% end %>
          </div>
        <% end %>
        <div class="flex flex-wrap items-center gap-3 text-xs sm:text-sm">
          <%# 件数バッジ（フィルタ有無で文言を出し分け） %>
          <% if @schedule_stats[:total_schedules].positive? %>
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold uppercase tracking-[0.3em] text-slate-400">
              <%= @selected_theater.present? ? '該当 ' : '全 ' %><%= @schedule_stats[:total_schedules] %> 件
            </span>
          <% end %>
          <%= link_to 'スケジュールを追加', new_admin_schedule_path(theater_id: @selected_theater_id), class: 'btn-primary text-xs sm:text-sm' %>
        </div>
      </div>
    </div>

    <% if @all_schedules.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-white/10 text-left text-sm text-slate-200">
          <thead class="bg-white/5 text-xs uppercase tracking-wider text-slate-400">
            <tr>
              <th scope="col" class="whitespace-nowrap px-4 py-3 font-semibold">ID</th>
              <th scope="col" class="whitespace-nowrap px-4 py-3 font-semibold">作品</th>
              <th scope="col" class="whitespace-nowrap px-4 py-3 font-semibold">劇場 / スクリーン</th>
              <th scope="col" class="whitespace-nowrap px-4 py-3 font-semibold">開始時刻</th>
              <th scope="col" class="whitespace-nowrap px-4 py-3 font-semibold">終了時刻</th>
              <th scope="col" class="whitespace-nowrap px-4 py-3 font-semibold">操作</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10">
            <% @all_schedules.each do |schedule| %>
              <% finished = schedule.end_time.present? && schedule.end_time < @now %>
              <tr class="transition hover:bg-white/10 <%= finished ? 'bg-white/[0.02]' : '' %>">
                <td class="whitespace-nowrap px-4 py-3 font-semibold">
                  <div class="flex items-center gap-3">
                    <% if finished %>
                      <span class="inline-block h-4 w-1 rounded-full bg-rose-400"></span>
                    <% end %>
                    <span class="<%= finished ? 'text-rose-200' : 'text-brand-gold' %>">#<%= schedule.id %></span>
                  </div>
                </td>
                <td class="whitespace-nowrap px-4 py-3">
                  <div class="flex flex-col">
                    <span class="font-semibold <%= finished ? 'text-slate-200' : 'text-white' %>"><%= schedule.movie&.name || '未設定' %></span>
                    <span class="text-xs <%= finished ? 'text-slate-500' : 'text-slate-400' %>">ID: <%= schedule.movie_id %></span>
                  </div>
                </td>
                <td class="whitespace-nowrap px-4 py-3">
                  <% if schedule.screen.present? %>
                    <div class="flex flex-col">
                      <span class="text-xs <%= finished ? 'text-slate-500' : 'text-slate-400' %>">劇場: <%= schedule.screen.theater&.name || '-' %></span>
                      <span class="<%= finished ? 'text-slate-200' : 'text-white' %>"><%= schedule.screen.name %></span>
                      <span class="text-xs <%= finished ? 'text-slate-500' : 'text-slate-400' %>">スクリーンID: <%= schedule.screen_id %></span>
                    </div>
                  <% else %>
                    <span class="text-slate-500">未設定</span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-xs text-slate-300">
                  <div class="flex items-center gap-2">
                    <span class="<%= finished ? 'line-through decoration-rose-400 text-slate-500' : '' %>"><%= schedule.start_time&.strftime('%Y-%m-%d %H:%M') || '-' %></span>
                    <% if finished %>
                      <span class="rounded-full border border-rose-400 bg-rose-500/10 px-2 py-[2px] text-[10px] font-semibold uppercase tracking-[0.25em] text-rose-100">終了済</span>
                    <% end %>
                  </div>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-xs text-slate-300">
                  <span class="<%= finished ? 'line-through decoration-rose-400 text-slate-500' : '' %>"><%= schedule.end_time&.strftime('%Y-%m-%d %H:%M') || '-' %></span>
                </td>
                <td class="whitespace-nowrap px-4 py-3">
                  <%= link_to '詳細・編集', admin_schedule_path(schedule), class: 'btn-secondary text-xs' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="rounded-lg border border-dashed border-white/10 bg-white/[0.02] px-6 py-10 text-center text-sm text-slate-400">
        表示できる上映スケジュールがまだありません。上の「スケジュールを追加」ボタンから登録を開始してください。
      </div>
    <% end %>
  </section>

  <% if @movie_schedules.present? %>
    <section class="card-surface space-y-6">
      <div>
        <p class="text-xs uppercase tracking-[0.35em] text-slate-500">By Movie</p>
        <h2 class="text-xl font-semibold text-white">作品別スケジュール</h2>
      </div>

      <% @movie_schedules.each do |movie, schedules| %>
        <% next if schedules.blank? %>
        <article class="rounded-xl border border-white/5 bg-white/[0.03] p-6">
          <header class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h3 class="text-lg font-semibold text-white"><%= movie.name %></h3>
              <p class="text-xs text-slate-400">作品ID: <%= movie.id %></p>
            </div>
            <div class="flex flex-wrap items-center gap-2 text-xs sm:text-sm">
              <%= link_to '作品詳細', admin_movie_path(movie), class: 'btn-secondary text-xs sm:text-sm' %>
              <%= link_to 'スケジュールを追加', new_admin_schedule_path(movie_id: movie.id), class: 'btn-primary text-xs sm:text-sm' %>
            </div>
          </header>

          <div class="mt-5 grid gap-3">
            <% schedules.each do |schedule| %>
              <% finished = schedule.end_time.present? && schedule.end_time < @now %>
              <div class="flex flex-wrap items-center justify-between gap-3 rounded-lg border p-4 text-sm <%= finished ? 'border-rose-500 bg-rose-500/10 text-rose-100' : 'border-white/10 bg-white/[0.04] text-slate-200' %>">
                <div class="flex flex-col">
                  <span class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500">Schedule</span>
                  <div class="flex items-center gap-2">
                    <% if finished %>
                      <span class="inline-block h-4 w-1 rounded-full bg-rose-400"></span>
                    <% end %>
                    <span class="font-semibold <%= finished ? 'text-rose-50' : 'text-white' %>">#<%= schedule.id %></span>
                    <% if finished %>
                      <span class="rounded-full border border-rose-400 bg-rose-500/10 px-2 py-[2px] text-[10px] font-semibold uppercase tracking-[0.25em] text-rose-100">終了済</span>
                    <% end %>
                  </div>
                </div>
                <div class="flex flex-col">
                  <span class="text-xs text-slate-500">劇場</span>
                  <span class="text-xs <%= finished ? 'text-rose-100' : 'text-slate-200' %>"><%= schedule.screen&.theater&.name || '-' %></span>
                  <span class="text-xs text-slate-500">スクリーン</span>
                  <span class="<%= finished ? 'text-rose-50' : 'text-white' %>"><%= schedule.screen&.name || '-' %> (ID: <%= schedule.screen_id %>)</span>
                </div>
                <div class="flex flex-col">
                  <span class="text-xs text-slate-500">開始</span>
                  <span class="<%= finished ? 'line-through decoration-rose-400 text-rose-50' : '' %>"><%= schedule.start_time&.strftime('%Y-%m-%d %H:%M') || '-' %></span>
                </div>
                <div class="flex flex-col">
                  <span class="text-xs text-slate-500">終了</span>
                  <span class="<%= finished ? 'line-through decoration-rose-400 text-rose-50' : '' %>"><%= schedule.end_time&.strftime('%Y-%m-%d %H:%M') || '-' %></span>
                </div>
                <div>
                  <%= link_to '編集', admin_schedule_path(schedule), class: 'btn-secondary text-xs' %>
                </div>
              </div>
            <% end %>
          </div>
        </article>
      <% end %>
    </section>
  <% end %>
</div>
