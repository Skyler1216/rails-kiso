<div class="page-shell space-y-10">
  <section class="page-hero">
    <div class="page-hero__content">
      <span class="page-hero__kicker">
        <span class="text-brand-gold">Admin</span>
        SCHEDULE MANAGEMENT
      </span>
      <h1 class="page-hero__title">上映スケジュール</h1>
      <p class="page-hero__description">
        作品ごとの上映スケジュールを確認・編集できます。作品名を見出しに、各スケジュールへのリンクを一覧で表示しています。
      </p>
    </div>
  </section>

  <section class="card-surface space-y-6">
    <% if @movies.any? %>
      <% @movies.each do |movie| %>
        <% schedules = movie.schedules.sort_by(&:start_time) %>
        <% next if schedules.blank? %>
        <article class="rounded-xl border border-white/5 bg-white/[0.03] p-6">
          <header class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-semibold text-white">
              作品ID: <%= movie.id %> / <%= movie.name %>
            </h2>
            <%= link_to '作品詳細', admin_movie_path(movie), class: 'text-sm text-brand-gold underline decoration-dotted underline-offset-4 hover:text-brand-red' %>
          </header>

          <ul class="mt-5 space-y-3">
            <% schedules.each do |schedule| %>
              <%= render partial: 'admin/schedules/schedule_summary', locals: { schedule: schedule } %>
            <% end %>
          </ul>
        </article>
      <% end %>
    <% else %>
      <div class="rounded-lg border border-dashed border-white/10 bg-white/[0.02] px-6 py-10 text-center text-sm text-slate-400">
        表示できる上映スケジュールがまだありません。映画詳細ページからスケジュールを追加してください。
      </div>
    <% end %>
  </section>
</div>
