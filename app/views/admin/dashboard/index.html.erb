<div class="page-shell space-y-10">
  <section class="page-hero">
    <div class="page-hero__content">
      <span class="page-hero__kicker">
        <span class="text-brand-gold">Admin</span>
        CONTROL CENTER
      </span>
      <h1 class="page-hero__title">ダッシュボード</h1>
      <p class="page-hero__description">
        最新の稼働状況と次のアクションをシンプルに確認できます。
      </p>
      <div class="mt-4 flex flex-wrap gap-3 text-xs sm:text-sm">
        <%= link_to '映画一覧', admin_movies_path, class: 'btn-secondary' %>
        <%= link_to '上映スケジュール', admin_schedules_path, class: 'btn-secondary' %>
        <%= link_to '予約一覧', admin_reservations_path, class: 'btn-secondary' %>
      </div>
    </div>
  </section>

  <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <div class="card-surface space-y-3">
      <h2 class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-400">Movies</h2>
      <p class="text-3xl font-semibold text-white"><%= @stats[:movies][:total] %></p>
      <div class="flex items-center gap-4 text-xs text-slate-400">
        <span>上映中 <strong class="text-white"><%= @stats[:movies][:showing] %></strong></span>
        <span>上映予定 <strong class="text-white"><%= @stats[:movies][:upcoming] %></strong></span>
      </div>
      <%= link_to '作品を追加', new_admin_movie_path, class: 'btn-primary w-full text-xs sm:text-sm' %>
    </div>

    <div class="card-surface space-y-3">
      <h2 class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-400">Schedules</h2>
      <p class="text-3xl font-semibold text-white"><%= @stats[:schedules][:total] %></p>
      <div class="flex items-center gap-4 text-xs text-slate-400">
        <span>本日 <strong class="text-white"><%= @stats[:schedules][:today] %></strong></span>
        <span>今後 <strong class="text-white"><%= @stats[:schedules][:upcoming] %></strong></span>
      </div>
      <%= link_to 'スケジュールを追加', new_admin_schedule_path, class: 'btn-primary w-full text-xs sm:text-sm' %>
    </div>

    <div class="card-surface space-y-3">
      <h2 class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-400">Reservations</h2>
      <p class="text-3xl font-semibold text-white"><%= @stats[:reservations][:total] %></p>
      <div class="flex items-center gap-4 text-xs text-slate-400">
        <span>本日 <strong class="text-white"><%= @stats[:reservations][:today] %></strong></span>
        <span>今後 <strong class="text-white"><%= @stats[:reservations][:upcoming] %></strong></span>
      </div>
      <%= link_to '予約を追加', new_admin_reservation_path, class: 'btn-primary w-full text-xs sm:text-sm' %>
    </div>
  </section>

  <section class="grid gap-6 lg:grid-cols-2">
    <div class="card-surface space-y-4">
      <header class="flex items-center justify-between text-sm">
        <div>
          <p class="uppercase tracking-[0.3em] text-slate-500">Upcoming Schedules</p>
          <h2 class="text-lg font-semibold text-white">これからの上映</h2>
        </div>
        <%= link_to '一覧を見る', admin_schedules_path, class: 'text-xs text-slate-400 hover:text-white transition' %>
      </header>
      <% if @upcoming_schedules.any? %>
        <ul class="space-y-3 text-sm">
          <% @upcoming_schedules.each do |schedule| %>
            <li class="flex items-center justify-between gap-3 rounded-lg border border-white/10 bg-white/[0.04] px-4 py-3">
              <div class="flex flex-col">
                <span class="text-white font-semibold"><%= schedule.movie&.name || '未設定' %></span>
                <span class="text-xs text-slate-400">スクリーン <%= schedule.screen&.name || schedule.screen_id %></span>
              </div>
              <div class="text-right text-xs text-slate-400">
                <p class="text-sm text-white font-semibold"><%= schedule.start_time&.strftime('%m/%d %H:%M') || '-' %></p>
                <p>〜 <%= schedule.end_time&.strftime('%H:%M') || '-' %></p>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="rounded-lg border border-dashed border-white/10 bg-white/[0.02] px-4 py-6 text-center text-xs text-slate-400">
          予定されている上映がまだありません。
        </p>
      <% end %>
    </div>

    <div class="card-surface space-y-4">
      <header class="flex items-center justify-between text-sm">
        <div>
          <p class="uppercase tracking-[0.3em] text-slate-500">Upcoming Reservations</p>
          <h2 class="text-lg font-semibold text-white">これからの予約</h2>
        </div>
        <%= link_to '一覧を見る', admin_reservations_path, class: 'text-xs text-slate-400 hover:text-white transition' %>
      </header>
      <% if @upcoming_reservations.any? %>
        <ul class="space-y-3 text-sm">
          <% @upcoming_reservations.each do |reservation| %>
            <li class="flex items-center justify-between gap-3 rounded-lg border border-white/10 bg-white/[0.04] px-4 py-3">
              <div class="flex flex-col">
                <span class="text-white font-semibold"><%= reservation.name %></span>
                <span class="text-xs text-slate-400"><%= reservation.email %></span>
              </div>
              <div class="text-right text-xs text-slate-400">
                <p class="text-sm text-white font-semibold"><%= reservation.date&.strftime('%m/%d') %> <%= reservation.schedule&.start_time&.strftime('%H:%M') %></p>
                <p><%= reservation.schedule&.movie&.name || '未設定' %></p>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="rounded-lg border border-dashed border-white/10 bg-white/[0.02] px-4 py-6 text-center text-xs text-slate-400">
          これからの予約はまだありません。
        </p>
      <% end %>
    </div>
  </section>

  <section class="card-surface space-y-4">
    <header class="flex items-center justify-between text-sm">
      <div>
        <p class="uppercase tracking-[0.3em] text-slate-500">Recently Updated</p>
        <h2 class="text-lg font-semibold text-white">最近更新された作品</h2>
      </div>
      <%= link_to '映画を管理', admin_movies_path, class: 'text-xs text-slate-400 hover:text-white transition' %>
    </header>
    <% if @recent_movies.any? %>
      <ul class="grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        <% @recent_movies.each do |movie| %>
          <li class="rounded-lg border border-white/10 bg-white/[0.04] p-3">
            <p class="font-semibold text-white truncate"><%= movie.name %></p>
            <p class="text-xs text-slate-400">更新: <%= movie.updated_at.strftime('%m/%d %H:%M') %></p>
            <%= link_to '詳細を開く', admin_movie_path(movie), class: 'mt-2 inline-flex text-xs text-brand-gold hover:text-white transition' %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="rounded-lg border border-dashed border-white/10 bg-white/[0.02] px-4 py-6 text-center text-xs text-slate-400">
        最近更新された作品はありません。
      </p>
    <% end %>
  </section>
</div>
