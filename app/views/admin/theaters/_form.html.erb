<%# ============================================================================
    # 劇場フォーム - 部分テンプレート
    # ============================================================================
    # 管理者用の劇場作成・編集フォームです。
    # 劇場の基本情報（名前、住所、電話番号、営業状態）と
    # 関連するスクリーンの管理機能を提供します。
    # JavaScriptでスクリーンの動的追加・削除が可能です。
    # ============================================================================
%>

<%# ローカル変数の設定（デフォルト値付き） %>
<% heading = local_assigns.fetch(:heading, '劇場情報') %>
<% subheading = local_assigns.fetch(:subheading, nil) %>
<% submit_label = local_assigns.fetch(:submit_label, '保存する') %>
<% submit_note = local_assigns.fetch(:submit_note, nil) %>
<% show_delete = local_assigns.fetch(:show_delete, false) %>

<article class="rounded-xl border border-white/5 bg-white/[0.03] p-6" data-screen-fields>
  <header class="flex flex-wrap items-center justify-between gap-3">
    <h2 class="text-base font-semibold text-white"><%= heading %></h2>
    <% if subheading.present? %>
      <span class="text-xs uppercase tracking-[0.3em] text-slate-500"><%= subheading %></span>
    <% end %>
  </header>

  <%# フラッシュメッセージの表示（コントローラーからの通知） %>
  <% if flash[:alert].present? %>
    <div class="mt-4 rounded-lg border border-brand-red/40 bg-brand-red/10 px-4 py-3 text-sm text-brand-red">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%# バリデーションエラーの表示 %>
  <% if theater.errors.any? %>
    <%# スクリーン名の重複エラーは個別フィールドで表示するため、サマリーから除外 %>
    <% summary_messages = theater.errors.map(&:full_message).reject do |msg|
         msg.include?('同じ劇場内で一意になるよう設定してください') ||
         msg.include?('スクリーン名が重複しています')
       end %>
    <% if summary_messages.any? %>
      <div class="mt-4 rounded-lg border border-brand-red/40 bg-brand-red/10 px-4 py-3 text-sm text-brand-red">
        <p class="font-semibold">入力内容を確認してください。</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <% summary_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>

  <%= form_with model: [:admin, theater], local: true, class: 'mt-6 space-y-8' do |f| %>
    <%# 劇場基本情報入力セクション %>
    <div class="grid gap-6 md:grid-cols-2">
      <%# 劇場名入力フィールド %>
      <div class="space-y-2">
        <%= f.label :name, '劇場名', class: 'text-sm font-semibold text-white' %>
        <%= f.text_field :name, class: 'form-input', placeholder: '例: シネマ中央劇場', required: true %>
        <%# 劇場名のバリデーションエラー表示 %>
        <% if theater.errors[:name].present? %>
          <p class="text-xs text-brand-red"><%= theater.errors.full_messages_for(:name).join('、') %></p>
        <% end %>
      </div>

      <%# 電話番号入力フィールド（任意項目） %>
      <div class="space-y-2">
        <%= f.label :phone, '電話番号', class: 'text-sm font-semibold text-white' %>
        <%= f.telephone_field :phone, class: 'form-input', placeholder: '例: 03-1234-5678' %>
        <%# 電話番号のバリデーションエラー表示 %>
        <% if theater.errors[:phone].present? %>
          <p class="text-xs text-brand-red"><%= theater.errors.full_messages_for(:phone).join('、') %></p>
        <% end %>
      </div>

      <%# 住所入力フィールド（必須項目・全幅表示） %>
      <div class="space-y-2 md:col-span-2">
        <%= f.label :address, '住所', class: 'text-sm font-semibold text-white' %>
        <%= f.text_area :address, rows: 3, class: 'form-textarea', placeholder: '例: 東京都千代田区1-2-3', required: true %>
        <%# 住所のバリデーションエラー表示 %>
        <% if theater.errors[:address].present? %>
          <p class="text-xs text-brand-red"><%= theater.errors.full_messages_for(:address).join('、') %></p>
        <% end %>
      </div>

      <%# 営業状態チェックボックス（全幅表示） %>
      <div class="md:col-span-2">
        <div class="flex items-start gap-3">
          <%= f.check_box :is_active, class: 'mt-1 h-4 w-4' %>
          <div>
            <%= f.label :is_active, '営業中', class: 'text-sm font-semibold text-white' %>
            <p class="text-xs text-slate-400">チェックを外すと非アクティブ状態として扱われます。</p>
          </div>
        </div>
      </div>
    </div>

    <%# スクリーン管理セクション - ネストされた属性の動的管理 %>
    <section class="rounded-lg border border-white/10 bg-white/5 p-4 space-y-4" data-screen-fields-section>
      <%# セクションヘッダー - スクリーン管理の説明 %>
      <header class="space-y-1">
        <h3 class="text-sm font-semibold text-white">スクリーンを登録</h3>
        <p class="text-xs text-slate-400">
          劇場に紐づくスクリーン名を管理します。必要な数だけ追加し、不要になったスクリーンは削除してください。
        </p>
      </header>

      <%# 既存スクリーンがある場合の操作説明 %>
      <% if theater.screens.any?(&:persisted?) %>
        <p class="text-xs text-slate-400">登録済みのスクリーン名を編集できます。削除したい場合は「削除」をクリックしてください。</p>
      <% end %>

      <%# 既存スクリーンフィールドの表示エリア %>
      <%# fields_for :screens により、各スクリーンのフォームフィールドを生成 %>
      <div class="space-y-3" data-screen-fields-list>
        <%= f.fields_for :screens do |screen_fields| %>
          <%= render 'screen_fields_row', screen_fields: screen_fields %>
        <% end %>
      </div>

      <%# 新規スクリーンフィールドのテンプレート（JavaScriptで使用） %>
      <%# child_index: 'NEW_SCREEN' により、JavaScriptで動的に追加する際のプレースホルダーを設定 %>
      <template data-screen-fields-template>
        <%= f.fields_for :screens, Screen.new, child_index: 'NEW_SCREEN' do |screen_fields| %>
          <%= render 'screen_fields_row', screen_fields: screen_fields %>
        <% end %>
      </template>

      <%# スクリーン追加ボタンと操作説明 %>
      <div class="flex flex-wrap items-center gap-3">
        <%# JavaScriptで動的にスクリーンフィールドを追加するボタン %>
        <button type="button" class="btn-secondary text-xs sm:text-sm" data-screen-fields-add>スクリーンを追加</button>
        <%# 空欄のスクリーンは保存されない旨の説明 %>
        <p class="text-xs text-slate-500">追加したスクリーンは空欄のままでは保存されません。</p>
      </div>
    </section>

    <%# フォーム操作ボタンセクション %>
    <div class="flex flex-wrap items-center gap-3">
      <%# メインの送信ボタン（作成時は「保存する」、編集時は「更新する」） %>
      <%= f.submit submit_label, class: 'btn-primary' %>
      <%# 送信先URLなどの補足情報（デバッグ用） %>
      <% if submit_note.present? %>
        <span class="text-xs text-slate-500"><%= submit_note %></span>
      <% end %>
    </div>
  <% end %>

  <%# 削除ボタン（編集時のみ表示） %>
  <%# show_delete が true の場合のみ表示（新規作成時は非表示） %>
  <% if show_delete %>
    <div class="mt-4">
      <%# button_to により DELETE リクエストを送信 %>
      <%# data-confirm により削除前に確認ダイアログを表示 %>
      <%= button_to '劇場を削除', admin_theater_path(theater), method: :delete,
                    data: { confirm: '本当にこの劇場を削除しますか？関連するスクリーンも削除されます。' },
                    class: 'btn-secondary border border-red-400/50 text-red-200 hover:bg-red-500/20 hover:text-white' %>
    </div>
  <% end %>
</article>
