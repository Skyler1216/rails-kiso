<div class="auth-page">
  <div class="auth-panel">
    <header class="auth-panel__header">
      <p class="text-xs font-semibold uppercase tracking-[0.45em] text-brand-gold">CineVerse</p>
      <h1 class="auth-panel__title">新規登録</h1>
      <p class="auth-panel__description">
        CineVerseアカウントを作成して、オンラインでの座席予約やお気に入り作品の管理、会員限定の特典をお楽しみください。
      </p>
    </header>

    <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5 text-sm text-slate-300 shadow-lg">
      <p class="font-semibold text-brand-gold">会員登録でできること</p>
      <ul class="mt-3 space-y-2">
        <li class="flex items-start gap-3">
          <span class="mt-1 inline-block h-2 w-2 rounded-full bg-brand-gold"></span>
          <span>上映スケジュールの最新情報をリアルタイムでチェック</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1 inline-block h-2 w-2 rounded-full bg-brand-gold"></span>
          <span>座席を指定して、事前にスムーズにオンライン予約</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1 inline-block h-2 w-2 rounded-full bg-brand-gold"></span>
          <span>お気に入り作品を保存し、推しの上映を逃さない</span>
        </li>
      </ul>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: 'auth-form' }) do |f| %>
      <%= render 'devise/shared/error_messages', resource: resource %>

      <div class="form-field">
        <%= f.label :name, '名前', class: 'form-label' %>
        <%= f.text_field :name, autofocus: true, autocomplete: 'name', class: 'form-input', placeholder: 'お名前を入力してください' %>
      </div>

      <div class="form-field">
        <%= f.label :email, 'メールアドレス', class: 'form-label' %>
        <%= f.email_field :email, autocomplete: 'email', class: 'form-input', placeholder: 'メールアドレスを入力してください' %>
      </div>

      <div class="form-field">
        <div class="flex items-center justify-between">
          <%= f.label :password, 'パスワード', class: 'form-label' %>
          <% if @minimum_password_length %>
            <span class="text-xs font-medium text-slate-400">最低 <%= @minimum_password_length %> 文字</span>
          <% end %>
        </div>
        <%= f.password_field :password, autocomplete: 'new-password', class: 'form-input', placeholder: 'パスワードを入力してください' %>
      </div>

      <div class="form-field">
        <%= f.label :password_confirmation, 'パスワード（確認）', class: 'form-label' %>
        <%= f.password_field :password_confirmation, autocomplete: 'new-password', class: 'form-input', placeholder: '確認用のパスワードを入力してください' %>
      </div>

      <div class="rounded-xl border border-white/10 bg-slate-900/60 p-4 text-xs text-slate-400">
        アカウント作成により、<span class="text-slate-200">利用規約</span>と<span class="text-slate-200">プライバシーポリシー</span>に同意したものとみなされます。
      </div>

      <div class="auth-actions">
        <%= f.submit '登録する', class: 'btn-primary w-full justify-center' %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= render 'devise/shared/links' %>
    </div>
  </div>
</div>
