<div class="auth-shell">
  <div class="auth-layout">
    <section class="auth-hero">
      <span class="auth-hero__kicker">おかえりなさい</span>
      <h1 class="auth-hero__title">CineVerseにログイン</h1>
      <p class="auth-hero__description">
        登録済みのメールアドレスとパスワードでログインしてください。ログインすると座席予約の履歴管理や、上映スケジュールのチェックがスムーズに行えます。
      </p>
    </section>

    <div class="auth-card">
      <div class="auth-card__content">
        <div class="auth-card__header">
          <h2>アカウントにアクセス</h2>
          <p>必要な情報を入力し、「ログインする」で続行します。</p>
        </div>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'auth-form' }) do |f| %>
          <div class="form-field">
            <%= f.label :email, 'メールアドレス', class: 'form-label' %>
            <%= f.email_field :email, autofocus: true, autocomplete: 'email', class: 'form-input', placeholder: 'メールアドレスを入力してください' %>
          </div>

          <div class="form-field">
            <%= f.label :password, 'パスワード', class: 'form-label' %>
            <%= f.password_field :password, autocomplete: 'current-password', class: 'form-input', placeholder: 'パスワードを入力してください' %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="auth-remember">
              <label>
                <%= f.check_box :remember_me %>
                <span>次回から自動的にログイン</span>
              </label>
            </div>
          <% end %>

          <div class="auth-actions">
            <%= f.submit 'ログインする', class: 'btn-primary w-full justify-center' %>
          </div>
        <% end %>

        <div class="auth-links">
          <%= render 'devise/shared/links' %>
        </div>
      </div>
    </div>
  </div>
</div>
