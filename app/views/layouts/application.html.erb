<!DOCTYPE html>
<html>
  <head>
    <%# ================================
        ページ共通のメタ情報とアセット読み込み
        - Google Fonts は Tailwind より前に読み込んでフォントを準備
        - Tailwind / application スタイルは Turbo が差分ロード可能なよう data 属性を付与
    %>
    <title>App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;600;700&family=Roboto+Slab:wght@600&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-brand-night text-gray-100 antialiased">
    <%# ============================================
        アプリケーション全体を包むラッパー
        - 背景色やベースのタイポグラフィをここで指定
        - ヘッダー + メインコンテンツで縦方向に構成
    %>
    <div class="flex min-h-screen flex-col">
      <%= render 'layouts/header' %>

      <%# ============================================
          メインコンテンツ領域
          - flash メッセージを最上部に表示
          - 各ページ固有の内容は yield で差し込む
      %>
      <main class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-6 px-4 py-6 sm:px-6 lg:px-8">
        <%# flash: 空文字を除外しつつ、種別に応じた装飾を適用 %>
        <% flash.each do |type, message| %>
          <% next if message.blank? %>
          <div class="<%= flash_banner_class(type) %>">
            <span><%= message %></span>
          </div>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
