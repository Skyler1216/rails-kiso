<!-- ========================================
    🔐 管理者専用ナビゲーション
    ========================================
    
    管理者がログインした時に表示される専用ナビゲーションバー
    - 管理者ダッシュボードへのクイックアクセス
    - 各管理機能への直接リンク
    - 映画館らしいブランディング
-->

<% if user_signed_in? && current_user.admin? %>
  <!-- #region ADMIN NAVIGATION BAR -->
  <div class="admin-nav bg-gradient-to-r from-red-900/30 to-red-800/20 border-b border-red-500/40 shadow-lg">
    <div class="mx-auto max-w-6xl px-4 py-3">
      <div class="flex items-center justify-between">
        
        <!-- #region ADMIN BRAND -->
        <div class="flex items-center gap-3">
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-red-600 text-sm font-bold text-white shadow-glow">A</span>
          <div class="leading-tight">
            <p class="font-heading text-lg text-red-300">Admin Panel</p>
            <p class="text-xs text-red-400">CineVerse Management</p>
          </div>
        </div>
        <!-- #endregion -->

        <!-- #region ADMIN NAVIGATION LINKS -->
        <nav class="flex items-center gap-6 text-sm">
          <%= link_to admin_root_path, 
              class: "admin-nav-link #{'admin-nav-active' if current_page?(admin_root_path)}" do %>
            <span class="mr-1">🏠</span>
            <span>ダッシュボード</span>
          <% end %>
          
          <%= link_to admin_movies_path, 
              class: "admin-nav-link #{'admin-nav-active' if current_page?(admin_movies_path)}" do %>
            <span class="mr-1">🎬</span>
            <span>映画管理</span>
          <% end %>
          
          <%= link_to admin_schedules_path, 
              class: "admin-nav-link #{'admin-nav-active' if current_page?(admin_schedules_path)}" do %>
            <span class="mr-1">📅</span>
            <span>スケジュール</span>
          <% end %>
          
          <%= link_to admin_reservations_path, 
              class: "admin-nav-link #{'admin-nav-active' if current_page?(admin_reservations_path)}" do %>
            <span class="mr-1">🎫</span>
            <span>予約管理</span>
          <% end %>
        </nav>
        <!-- #endregion -->

        <!-- #region ADMIN USER INFO -->
        <div class="flex items-center gap-4">
          <div class="text-right">
            <p class="text-sm font-semibold text-red-200"><%= current_user.name %></p>
            <p class="text-xs text-red-400">管理者</p>
          </div>
          
          <!-- 管理者専用ログアウトボタン -->
          <%= link_to destroy_user_session_path, 
              method: :delete, 
              data: { turbo: false },
              class: "admin-logout-btn",
              title: "管理者ログアウト" do %>
            <span class="text-lg">🚪</span>
          <% end %>
        </div>
        <!-- #endregion -->
        
      </div>
    </div>
  </div>
  <!-- #endregion -->
<% end %>
