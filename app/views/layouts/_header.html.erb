<%# ========================================
    🎬 メインナビゲーションヘッダー
    ========================================
    
    全ページ共通のヘッダーコンポーネント
    - ブランドロゴ（CineVerse）
    - グローバルナビゲーション（上映作品・座席一覧）
    - 認証状態に応じたアクションボタン（ログイン・登録・ログアウト）
    
    呼び出し元: application.html.erb
%>

<header class="border-b border-white/10 bg-slate-900/80 shadow-md backdrop-blur">

  <%# 📱 レスポンシブコンテナ: モバイル縦並び → デスクトップ横並び %>
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
    
    <%# 🏠 左エリア: ブランドロゴ + グローバルナビ %>
    <div class="flex flex-1 items-center justify-between gap-6">
      
      <%# 🎭 ブランドロゴ: CineVerse（トップページへのリンク） %>
      <%= link_to root_path, class: "flex items-center gap-3" do %>
        <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-brand-red text-lg font-bold text-white shadow-glow">C</span>
        <div class="leading-tight">
          <p class="font-heading text-lg text-brand-gold">CineVerse</p>
          <p class="text-xs text-gray-400">Cinema Experience</p>
        </div>
      <% end %>

      <%# 🧭 グローバルナビゲーション: 主要ページへのリンク %>
      <nav class="flex items-center gap-2 md:gap-3">
        <%= link_to '上映作品', movies_path, class: header_nav_link_class(movies_path) %>
        <%= link_to '座席一覧', sheets_path, class: header_nav_link_class(sheets_path) %>
      </nav>
    </div>

    <%# 👤 右エリア: 認証状態に応じたアクションボタン %>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      
      <% if user_signed_in? %>
        <%# ✅ ログイン済み: ユーザー名表示 + ログアウトボタン %>
        <p class="text-sm text-gray-300"><%= "ようこそ、#{current_user.name} さん！" %></p>
        <%= link_to 'ログアウト', destroy_user_session_path, method: :delete, data: { turbo: false }, class: header_secondary_button_class %>
      <% else %>
        <%# 🔐 未ログイン: ログイン + 新規登録ボタン %>
        <div class="flex items-center gap-3">
          <%= link_to 'ログイン', new_user_session_path, class: header_secondary_button_class %>
          <%= link_to 'ユーザー登録', new_user_registration_path, class: header_primary_button_class %>
        </div>
      <% end %>
      
    </div>
  </div>

  <% if current_user&.admin? %>
    <div class="admin-toolbar">
      <div class="admin-toolbar__content">
        <div class="admin-toolbar__info">
          <span class="admin-toolbar__badge">Admin</span>
          <div>
            <p class="admin-toolbar__title">管理者モード</p>
            <p class="admin-toolbar__subtitle">管理機能へのショートカット</p>
          </div>
        </div>

        <nav class="admin-toolbar__nav">
          <%= link_to 'ダッシュボード', admin_root_path, class: admin_nav_link_class(admin_root_path) %>
          <%= link_to '映画管理', admin_movies_path, class: admin_nav_link_class(admin_movies_path) %>
          <%= link_to 'スケジュール', admin_schedules_path, class: admin_nav_link_class(admin_schedules_path) %>
          <%= link_to '予約管理', admin_reservations_path, class: admin_nav_link_class(admin_reservations_path) %>
        </nav>
      </div>
    </div>
  <% end %>
</header>
